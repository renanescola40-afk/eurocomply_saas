{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.risckcomply.com/schemas/security-questionnaire.schema.json",
  "title": "RISCK COMPLY Enterprise Security Questionnaire",
  "type": "object",
  "additionalProperties": false,
  "required": ["product", "version", "generatedAt", "disclosure", "answers"],
  "properties": {
    "product": { "const": "RISCK COMPLY" },
    "version": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "disclosure": { "type": "string", "minLength": 20 },
    "answers": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "question", "answer", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{2}$" },
          "category": { "enum": ["governance", "access-control", "data-protection", "operations", "compliance", "suppliers"] },
          "question": { "type": "string", "minLength": 10 },
          "answer": { "type": "string", "minLength": 20 },
          "status": { "enum": ["implemented", "configuration-bound", "evidence-required", "not-claimed"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "format": "uri" }
          },
          "caveat": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
