  "status": "implemented_pending_ci",
  "scope": "enterprise_gdpr_privacy_controls",
  "controls": {
    "dataInventory": {
      "status": "documented",
      "path": "docs/privacy/DATA_INVENTORY.md",
      "datasets": [
        "users",
        "organizations",
        "organization_members",
        "documents",
        "risks",
        "vendors",
        "tasks",
        "audit_events",
        "notifications",
        "subscriptions",
        "billing_metadata",
        "logs"
      ]
    },
    "retentionPolicy": {
      "status": "documented",
      "path": "docs/privacy/DATA_RETENTION_POLICY.md",
      "legalBillingRetentionPreserved": true,
      "auditChainHardDeleteProhibited": true,
      "deleteSafetyDelayHours": 72
    },
    "organizationExport": {
      "route": "src/app/api/gdpr/export/route.ts",
      "rbac": "export_data",
      "stepUpAction": "export_data",
      "tenantScoped": true,
      "crossTenantExplicitOrganizationIdRejected": true,
      "noStoreDownload": true,
      "auditEvent": "gdpr_export_requested",
      "inventorySource": "src/server/privacy/gdpr.ts"
    },
    "deleteRequest": {
      "route": "src/app/api/gdpr/delete-request/route.ts",
      "rbac": "manage_settings",
      "stepUpAction": "gdpr_delete",
      "confirmationRequired": "DELETE ORGANIZATION DATA",
      "safetyDelayHours": 72,
      "auditEvent": "gdpr_delete_requested",
      "legalBillingRetentionPreserved": true,
      "auditChainPreserved": true
    },
    "adminUi": {
      "path": "src/app/[locale]/dashboard/privacy/page.tsx",
      "supportsExport": true,
      "supportsDeleteRequest": true,
      "requiresStepUpTokenInput": true,
      "requiresDeleteConfirmationInput": true
    },
    "tests": {
      "path": "tests/privacy/gdpr.test.ts",
      "covers": [
        "export_authorized_roles",
        "export_without_permission",
        "cross_tenant_step_up_rejection",
        "delete_without_step_up",
        "delete_with_step_up",
        "delete_preserves_legal_billing_audit_records"
      ]
    }
  },
  "manualValidation": [
    "Run npm run test -- tests/privacy/gdpr.test.ts",
    "Run npm run security:no-store",
    "Run npm run security:authorization-bola",
    "Run npm run security:audit-chain",
    "Verify /api/gdpr/export response contains no-store headers and Content-Disposition attachment",
