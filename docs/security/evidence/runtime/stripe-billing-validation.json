  "runtimeControls": {
    "checkout": {
      "route": "src/app/api/billing/checkout/route.ts",
      "requiresAuthenticatedUser": true,
      "requiresOrganizationContext": true,
      "requiresPermission": "manage_billing",
      "requiresStepUpAction": "manage_billing",
      "requiresTrustedOrigin": true,
      "usesServerSidePriceMapping": true,
      "rejectsClientSuppliedEnterprisePlan": true,
      "auditAction": "billing.checkout_start"
    },
    "billingPortal": {
      "route": "src/app/api/billing/portal/route.ts",
      "requiresAuthenticatedUser": true,
      "requiresOrganizationContext": true,
      "requiresPermission": "manage_billing",
      "requiresStepUpAction": "manage_billing",
      "requiresTrustedMutation": true,
      "loadsStripeCustomerFromSubscriptionsTable": true,
      "auditAction": "billing.portal_start"
    },
    "webhook": {
      "route": "src/app/api/stripe/webhook/route.ts",
      "handler": "src/server/billing/stripe-webhooks.ts",
      "requiresStripeSignature": true,
      "signatureToleranceSeconds": 300,
      "maxPayloadBytes": 1000000,
      "supportedEvents": [
        "checkout.session.completed",
        "customer.subscription.created",
        "customer.subscription.updated",
        "customer.subscription.deleted",
        "invoice.payment_failed"
      ],
      "unsupportedEventsIgnored": true,
      "idempotencyTable": "public.stripe_events_processed",
      "claimsEventBeforeMutation": true,
      "duplicateEventsSkippedBeforeSubscriptionMutation": true,
      "recordsProcessingStatus": ["processing", "processed", "failed"],
      "validatesOrganizationMetadata": ["organization_id", "organizationId"],
      "validatesCustomerBinding": true,
      "validatesSubscriptionBinding": true,
      "validatesPlanMetadata": true
    },
    "subscriptionSync": {
      "localAuthorityTable": "public.subscriptions",
      "syncFields": [
        "organization_id",
        "stripe_customer_id",
        "stripe_subscription_id",
        "plan",
        "tier",
        "status",
        "current_period_end",
        "updated_at"
      ],
      "upsertConflictTarget": "organization_id",
      "planSource": "Stripe subscription metadata only",
      "clientPlanMutationAllowed": false
    },
    "auditEvents": {
      "auditLogActions": [
        "billing.checkout_start",
        "billing.checkout_completed",
        "billing.portal_start",
        "billing.subscription_created",
        "billing.subscription_updated",
        "billing.subscription_deleted",
        "billing.payment_failed"
      ],
      "sensitiveMetadataSanitization": "src/lib/security/audit-log.ts"
    }
  },
