    {"id":"TEN-RLS","workflow":"supabase-live-rls-validation.yml","artifact_prefix":"supabase-live-rls-runtime-proof-","required":true,"inputs":{"release_sha":"${RELEASE_SHA}","promotion_run_id":"${SUPABASE_PROMOTION_RUN_ID}","confirmation":"EXECUTE_POST_V21_RUNTIME_PROOF"}},
    {"id":"FINAL-TECHNICAL","workflow":"final-technical-controls-proof.yml","artifact_prefix":"final-technical-controls-proof-","required":true,"inputs":{"release_sha":"${RELEASE_SHA}","confirmation":"EXECUTE_FINAL_TECHNICAL_PROOF"}},
