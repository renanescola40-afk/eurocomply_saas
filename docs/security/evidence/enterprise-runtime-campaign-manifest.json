{
  "schema_version": 2,
  "poll_interval_seconds": 20,
  "timeout_minutes_per_workflow": 60,
  "workflows": [
    {
      "id": "IAM-RBAC",
      "workflow": "auth-rbac-runtime-proof.yml",
      "artifact_prefix": "auth-rbac-runtime-proof-",
      "required": true,
      "inputs": {
        "release_sha": "${RELEASE_SHA}"
      },
      "classification": "core_required"
    },
    {
      "id": "IAM-LIFECYCLE",
      "workflow": "identity-access-lifecycle-proof.yml",
      "artifact_prefix": "identity-access-lifecycle-proof-",
      "required": true,
      "inputs": {
        "release_sha": "${RELEASE_SHA}",
        "confirmation": "EXECUTE_IDENTITY_LIFECYCLE_PROOF"
      },
      "classification": "core_required"
    },
    {
      "id": "IAM-SCIM",
      "workflow": "scim-runtime-proof.yml",
      "artifact_prefix": "scim-runtime-proof-",
      "required": false,
      "inputs": {
        "release_sha": "${RELEASE_SHA}",
        "confirmation": "EXECUTE_SCIM_RUNTIME_PROOF"
      },
      "classification": "conditional_when_configured"
    },
    {
      "id": "IAM-SAML",
      "workflow": "saml-sso-runtime-proof.yml",
      "artifact_prefix": "saml-sso-runtime-proof-",
      "required": false,
      "inputs": {
        "release_sha": "${RELEASE_SHA}",
        "confirmation": "EXECUTE_SAML_SSO_RUNTIME_PROOF"
      },
      "classification": "conditional_when_configured"
    },
    {
      "id": "TEN-RLS",
      "workflow": "supabase-live-rls-validation.yml",
      "artifact_prefix": "supabase-live-rls-runtime-proof-",
      "required": true,
      "inputs": {
        "release_sha": "${RELEASE_SHA}",
        "promotion_run_id": "${SUPABASE_PROMOTION_RUN_ID}",
        "reattestation_run_id": "${SUPABASE_REATTESTATION_RUN_ID}",
        "confirmation": "${SUPABASE_RLS_CONFIRMATION}",
        "current_state_run_id": "${SUPABASE_CURRENT_STATE_RUN_ID}"
      },
      "classification": "core_required"
    },
    {
      "id": "FINAL-TECHNICAL",
      "workflow": "final-technical-controls-proof.yml",
      "artifact_prefix": "final-technical-controls-proof-",
      "required": true,
      "inputs": {
        "release_sha": "${RELEASE_SHA}",
        "confirmation": "EXECUTE_FINAL_TECHNICAL_PROOF"
      },
      "classification": "core_required"
    },
    {
      "id": "PLATFORM",
      "workflow": "platform-providers-runtime-proof.yml",
      "artifact_prefix": "platform-providers-runtime-proof-",
      "required": true,
      "inputs": {
        "release_sha": "${RELEASE_SHA}"
      },
      "classification": "core_required"
    },
    {
      "id": "DATA",
      "workflow": "data-governance-runtime-proof.yml",
      "artifact_prefix": "data-governance-runtime-proof-",
      "required": true,
      "inputs": {
        "release_sha": "${RELEASE_SHA}",
        "confirmation": "EXECUTE_DATA_GOVERNANCE_PROOF"
      },
      "classification": "core_required"
    },
    {
      "id": "INCIDENT",
      "workflow": "incident-continuity-runtime-proof.yml",
      "artifact_prefix": "incident-continuity-runtime-proof-",
      "required": true,
      "inputs": {
        "release_sha": "${RELEASE_SHA}",
        "confirmation": "EXECUTE_INCIDENT_CONTINUITY_PROOF"
      },
      "classification": "core_required"
    },
    {
      "id": "TRUST",
      "workflow": "procurement-trust-runtime-proof.yml",
      "artifact_prefix": "procurement-trust-runtime-proof-",
      "required": true,
      "inputs": {
        "release_sha": "${RELEASE_SHA}",
        "confirmation": "EXECUTE_PROCUREMENT_TRUST_PROOF"
      },
      "classification": "core_required"
    },
    {
      "id": "RECOVERY",
      "workflow": "recovery-resilience-proof.yml",
      "artifact_prefix": "recovery-resilience-proof-",
      "required": true,
      "inputs": {
        "release_sha": "${RELEASE_SHA}",
        "exercise": "full",
        "confirmation": "${RECOVERY_ROLLBACK_CONFIRMATION}"
      },
      "classification": "core_required"
    },
    {
      "id": "PRODUCTION",
      "workflow": "production-runtime-proof.yml",
      "artifact_prefix": "production-runtime-proof-",
      "required": true,
      "inputs": {
        "release_sha": "${RELEASE_SHA}"
      },
      "classification": "core_required"
    },
    {
      "id": "REPOSITORY",
      "workflow": "branch-protection-runtime-proof.yml",
      "artifact_prefix": "branch-protection-runtime-proof-",
      "required": true,
      "inputs": {
        "release_sha": "${RELEASE_SHA}"
      },
      "classification": "core_required"
    },
    {
      "id": "STEP-UP",
      "workflow": "step-up-runtime-proof.yml",
      "artifact_prefix": "step-up-runtime-proof-",
      "required": true,
      "inputs": {
        "release_sha": "${RELEASE_SHA}"
      },
      "classification": "core_required"
    },
    {
      "id": "ASSURANCE",
      "workflow": "enterprise-final-assurance-proof.yml",
      "artifact_prefix": "enterprise-final-assurance-proof-",
      "required": false,
      "inputs": {
        "release_sha": "${RELEASE_SHA}",
        "confirmation": "VALIDATE_FINAL_ASSURANCE"
      },
      "classification": "external_assurance"
    }
  ]
}
