    {"id":"ASSURANCE","workflow":"enterprise-final-assurance-proof.yml","artifact_prefix":"enterprise-final-assurance-proof-","required":true,"inputs":{"release_sha":"${RELEASE_SHA}","confirmation":"VALIDATE_FINAL_ASSURANCE"}}
