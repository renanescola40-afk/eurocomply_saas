{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"risck-comply.qualified-review-assurance.v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","requirementId","reviewedSha","reviewer","qualification","independence","decision","reviewedAt","validUntil","evidenceDigest","limitations"],
  "properties":{
    "schema":{"const":"risck-comply.qualified-review-assurance.v1"},
    "requirementId":{"type":"string","minLength":3},
    "reviewedSha":{"type":"string","pattern":"^[a-f0-9]{40}$"},
    "reviewer":{"type":"object","required":["name","organization","contact"],"properties":{"name":{"type":"string","minLength":3},"organization":{"type":"string","minLength":2},"contact":{"type":"string","minLength":5}}},
    "qualification":{"type":"object","required":["title","jurisdictionOrDiscipline","evidence"],"properties":{"title":{"type":"string","minLength":3},"jurisdictionOrDiscipline":{"type":"string","minLength":2},"evidence":{"type":"array","minItems":1,"items":{"type":"string","minLength":3}}}},
    "independence":{"type":"object","required":["conflictChecked","conflictFound","statement"],"properties":{"conflictChecked":{"const":true},"conflictFound":{"const":false},"statement":{"type":"string","minLength":20}}},
    "decision":{"enum":["APPROVED","APPROVED_WITH_LIMITATIONS","REJECTED"]},
    "reviewedAt":{"type":"string","format":"date-time"},
    "validUntil":{"type":"string","format":"date-time"},
    "evidenceDigest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "limitations":{"type":"array","items":{"type":"string","minLength":3}}
  }
}
