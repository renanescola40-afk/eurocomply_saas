{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://risckcomply.example/schemas/qualified-review-operations.schema.json",
  "title": "Qualified Review Operations Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "decisionOnIncomplete", "defaultSlaDays", "reviews"],
  "properties": {
    "schema": {"const": "risck-comply.qualified-review-operations.v1"},
    "repository": {"const": "renanescola40-afk/eurocomply_saas"},
    "decisionOnIncomplete": {"const": "QUALIFIED_REVIEW_OPERATIONS_NO_GO"},
    "defaultSlaDays": {"type": "integer", "minimum": 1, "maximum": 90},
    "reviews": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "workstream", "weight", "status", "requiredExpertise", "independenceRequired"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"},
          "workstream": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{1,79}$"},
          "weight": {"type": "integer", "minimum": 1, "maximum": 20},
          "status": {"enum": ["UNASSIGNED", "ASSIGNED", "IN_REVIEW", "CHANGES_REQUESTED", "ACCEPTED", "REJECTED", "EXPIRED"]},
          "requiredExpertise": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 3, "maxLength": 200}},
          "independenceRequired": {"const": true}
        }
      }
    }
  }
}
