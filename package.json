{
  "name": "eurocomply-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/preflight.mjs",
    "quality:routes": "node scripts/quality/check-route-links.mjs",
    "security:rls": "node scripts/security/check-rls.mjs",
    "security:api-guards": "node scripts/security/check-api-guards.mjs",
    "security:protected-routes": "node scripts/security/check-protected-routes.mjs",
    "security:public-secrets": "node scripts/security/check-public-secrets.mjs",
    "security:client-boundaries": "node scripts/security/check-client-boundaries.mjs",
    "security:headers": "node scripts/security/check-security-headers.mjs",
    "security:no-store": "node scripts/security/check-no-store.mjs",
    "security:origin-guards": "node scripts/security/check-origin-guards.mjs",
    "security:upload": "node scripts/security/check-upload-security.mjs",
    "security:responses": "node scripts/security/check-security-responses.mjs",
    "security:audit-chain": "node scripts/security/check-audit-chain.mjs",
    "security:github-workflows": "node scripts/security/check-github-security-workflows.mjs",
    "security:supply-chain": "node scripts/security/check-supply-chain.mjs",
    "security:final-readiness": "node scripts/security/check-final-security-readiness.mjs",
    "security:final-readiness:report": "node scripts/security/write-final-readiness-report.mjs final-security-readiness.json",
    "supply-chain:lockfile": "npm install --package-lock-only --ignore-scripts",
    "supply-chain:floating-deps": "node scripts/security/list-floating-dependencies.mjs",
    "security:npm-audit:prod": "npm audit --omit=dev --audit-level=high",
    "security:npm-audit:all": "npm audit --audit-level=moderate",
    "security:npm-audit:json": "npm audit --json",
    "security:npm-audit:summary": "node scripts/security/summarize-npm-audit.mjs npm-audit.json",
    "security:ci": "npm run preflight && npm run quality:routes && npm run security:rls && npm run security:api-guards && npm run security:protected-routes && npm run security:public-secrets && npm run security:client-boundaries && npm run security:headers && npm run security:no-store && npm run security:origin-guards && npm run security:upload && npm run security:responses && npm run security:audit-chain && npm run security:github-workflows && npm run security:supply-chain && npm run typecheck && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "latest",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.9",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@sentry/nextjs": "^10.42.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.88.0",
    "@zoerai/integration": "0.0.8",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "3.6.0",
    "dompurify": "^3.2.4",
    "embla-carousel-react": "8.5.1",
    "framer-motion": "latest",
    "input-otp": "1.4.2",
    "isomorphic-dompurify": "^2.16.0",
    "jsdom": "^26.0.0",
    "lucide-react": "^0.454.0",
    "next": "15.5.9",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.4",
    "react": "^19",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19",
    "react-hook-form": "^7.54.1",
    "react-hot-toast": "2.4.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.0",
    "sonner": "^1.7.1",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.2.5",
    "vaul": "latest",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}