{
  "name": "eurocomply-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev -H 0.0.0.0",
    "prebuild": "npm run security:zod-compat",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/preflight.mjs",
    "clerk:env": "node scripts/dev/check-clerk-env.mjs",
    "phase1:check": "node scripts/dev/run-phase1-checks.mjs",
    "phase1:capture": "node scripts/dev/capture-phase1-evidence.mjs",
    "phase1:smoke": "node scripts/dev/capture-phase1-smoke.mjs",
    "phase1:evidence": "node scripts/dev/check-phase1-evidence-status.mjs",
    "phase1:repo-ready": "node scripts/dev/check-phase1-repo-side-readiness.mjs",
    "phase1:closeout": "npm run phase1:evidence && npm run phase1:check",
    "phase2:plan": "node scripts/dev/check-phase2-plan.mjs",
    "phase2:day1": "node scripts/dev/capture-phase2-day1.mjs",
    "phase2:day1:evidence": "node scripts/dev/check-phase2-day1-evidence.mjs",
    "phase2:day1:closeout": "npm run phase2:day1 && npm run phase2:day1:evidence",
    "phase2:day2": "node scripts/dev/capture-phase2-day2.mjs",
    "phase2:day2:evidence": "node scripts/dev/check-phase2-day2-evidence.mjs",
    "phase2:day2:closeout": "npm run phase2:day2 && npm run phase2:day2:evidence",
    "phase2:day3:smoke": "node scripts/dev/capture-phase2-day3-smoke.mjs",
    "phase2:day3:evidence": "node scripts/dev/check-phase2-day3-evidence.mjs",
    "phase2:day3:closeout": "npm run phase2:day3:smoke && npm run phase2:day3:evidence",
    "phase2:day4:evidence": "node scripts/dev/check-phase2-day4-evidence.mjs",
    "phase2:day4:closeout": "npm run phase2:day4:evidence",
    "phase2:ci": "npm ci && npm run lint && npm run typecheck && npm run test && npm run build && npm run security:ci",
    "phase2:evidence": "node scripts/dev/check-phase2-evidence-status.mjs",
    "phase3:files": "node scripts/dev/check-phase3-script-files.mjs",
    "phase3:day1": "npm run phase3:files && npm run phase3:check && node scripts/dev/check-phase3-day1-closeout.mjs",
    "phase3:day2": "node scripts/dev/check-phase3-runtime-readiness.mjs && node scripts/dev/check-phase3-auth-session-readiness.mjs && node scripts/dev/check-phase3-day2-closeout.mjs",
    "phase3:day3": "node scripts/dev/check-phase3-day3-files.mjs && npm run phase3:check && node scripts/dev/check-phase3-day3-closeout.mjs",
    "phase3:day4": "node scripts/dev/check-phase3-day4-files.mjs && node scripts/dev/check-phase3-completion-gates.mjs && node scripts/dev/check-phase3-evidence-pack.mjs && node scripts/dev/check-phase3-owner-acceptance-template.mjs && node scripts/dev/check-phase3-two-command-closeout.mjs && node scripts/dev/check-phase3-day4-closeout.mjs",
    "phase3:days": "npm run phase3:day1 && npm run phase3:day2 && npm run phase3:day3 && npm run phase3:day4",
    "phase3:check": "node scripts/dev/check-phase3-production-readiness.mjs",
    "phase3:strict": "node scripts/dev/run-phase3-strict.mjs",
    "phase3:closeout": "node scripts/dev/run-phase3-closeout.mjs",
    "phase4:check": "node scripts/dev/run-phase4-checks.mjs",
    "phase4:day1": "node scripts/dev/check-phase4-kickoff.mjs && node scripts/dev/check-phase4-scope.mjs && node scripts/dev/check-phase4-inventory.mjs && node scripts/dev/check-phase4-day1-closeout.mjs",
    "phase4:day2": "node scripts/dev/check-phase4-data-flow.mjs && node scripts/dev/check-phase4-access-model.mjs && node scripts/dev/check-phase4-day2-closeout.mjs",
    "phase4:day3": "node scripts/dev/check-phase4-operational-assumptions.mjs && node scripts/dev/check-phase4-implementation-readiness.mjs && node scripts/dev/check-phase4-day3-closeout.mjs",
    "phase4:day4": "node scripts/dev/check-phase4-final-review.mjs && node scripts/dev/check-phase4-next-implementation-plan.mjs && node scripts/dev/check-phase4-validation-commands.mjs",
    "phase4:days": "npm run phase4:day1 && npm run phase4:day2 && npm run phase4:day3 && npm run phase4:day4",
    "phase4:closeout": "npm run phase4:days && npm run phase4:check && npm run phase4:review",
    "phase4:review": "node scripts/dev/check-phase4-final-review.mjs && node scripts/dev/check-phase4-next-implementation-plan.mjs && node scripts/dev/check-phase4-validation-commands.mjs",
    "phase5:day1": "node scripts/dev/check-phase5-kickoff.mjs && node scripts/dev/check-phase5-scope.mjs && node scripts/dev/check-phase5-inventory.mjs && node scripts/dev/check-phase5-discovery-notes.mjs && node scripts/dev/check-phase5-day1-closeout.mjs",
    "phase5:day2": "node scripts/dev/check-phase5-functional-inventory.mjs && node scripts/dev/check-phase5-validation-plan.mjs && node scripts/dev/check-phase5-day2-closeout.mjs",
    "phase5:day3": "node scripts/dev/check-phase5-dashboard-invariants.mjs && node scripts/dev/check-phase5-focused-test.mjs && node scripts/dev/check-phase5-day3-closeout.mjs",
    "phase5:check": "node scripts/dev/run-phase5-checks.mjs",
    "phase5:review": "npm run phase5:check && npm run test",
    "phase6:check": "node scripts/dev/run-phase6-checks.mjs",
    "phase6:review": "npm run phase6:check && npm run test",
    "phase6:verify": "npm run phase6:review && npm run lint && npm run typecheck && npm run build",
    "phase7:check": "node scripts/dev/run-phase7-checks.mjs",
    "phase7:review": "npm run phase7:check && npm run test",
    "phase7:verify": "npm run phase7:review && npm run lint && npm run typecheck && npm run build",
    "phase8:check": "node scripts/dev/run-phase8-checks.mjs",
    "phase8:review": "npm run phase8:check && npm run test",
    "phase8:verify": "npm run phase8:review && npm run lint && npm run typecheck && npm run build",
    "phase9:check": "node scripts/dev/run-phase9-checks.mjs",
    "phase9:review": "npm run phase9:check && npm run test",
    "phase9:verify": "npm run phase9:review && npm run lint && npm run typecheck && npm run build",
    "phase10:check": "node scripts/dev/run-phase10-checks.mjs",
    "phase10:review": "npm run phase10:check && npm run test",
    "phase10:verify": "npm run phase10:review && npm run lint && npm run typecheck && npm run build",
    "quality:routes": "node scripts/quality/check-route-links.mjs && node scripts/quality/check-route-health-artifacts.mjs",
    "quality:routes:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "1.4.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.9",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.16",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@sentry/nextjs": "^10.59.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.88.0",
    "@zoerai/integration": "0.0.8",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "3.6.0",
    "dompurify": "3.4.11",
    "embla-carousel-react": "8.5.1",
    "framer-motion": "12.40.0",
    "input-otp": "1.4.2",
    "isomorphic-dompurify": "^2.16.0",
    "jsdom": "^26.0.0",
    "lucide-react": "^0.454.0",
    "next": "15.5.19",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.4",
    "react": "^19",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19",
    "react-hook-form": "^7.54.1",
    "react-hot-toast": "2.4.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.0",
    "sonner": "^1.7.1",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.2.5",
    "vaul": "1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
