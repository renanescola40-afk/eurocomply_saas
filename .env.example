# RISCK COMPLY environment variables
# Copy production values into provider secret stores only (Vercel Project Settings, GitHub Environments/Secrets, Supabase, Stripe, Sentry, PostHog).
# Do not commit real values in this file.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
NODE_ENV=development
RELEASE_TARGET=production
RISCK_COMPLY_PAID_BILLING_REQUIRED=false
# Keep disabled in Production until the V19 compliance_metric_snapshots schema is applied and proven compatible.
ENABLE_DASHBOARD_METRIC_SNAPSHOTS=false

# Supabase Auth and database
# Supabase Auth is the single primary identity provider for the active application.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# Supabase Auth / OAuth redirect allowlist
# Add exact callback URLs in Supabase Authentication > URL Configuration > Redirect URLs.
# Local: http://localhost:3000/auth/callback
# Production: https://<production-host>/auth/callback
# Preview: https://<preview-host>/auth/callback or the strict preview pattern approved for the deployment provider.
SUPABASE_AUTH_SITE_URL=http://localhost:3000
SUPABASE_AUTH_REDIRECT_URLS=http://localhost:3000/auth/callback,https://<production-host>/auth/callback,https://<preview-host>/auth/callback

# Google OAuth for Supabase Auth
# Store these values only in server-side/provider secret stores and Supabase Auth provider settings.
# Never prefix GOOGLE_CLIENT_SECRET with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Billing Portal configuration authority is versioned in config/stripe-billing-portal-contract.json.
# Canonical commercial catalog. Essential and Professional are self-serve runtime requirements.
STRIPE_PRICE_ESSENTIAL_MONTHLY=
STRIPE_PRICE_ESSENTIAL_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
# Business is sales-assisted. These canonical Prices are validated by the commercial catalog proof when configured.
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
# Transition-only compatibility for existing deployments/subscriptions. Do not use these values as proof of the canonical catalog.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
# Existing negotiated Enterprise contracts may retain dedicated historical Price IDs.
# Enterprise has no fixed generic public Price requirement for new sales-led contracts.
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
STRIPE_PRICE_BUSINESS_ENTERPRISE_MONTHLY=

# Email
RESEND_API_KEY=
EMAIL_FROM="RISCK COMPLY <no-reply@risckcomply.app>"
SUPPORT_EMAIL=support@risckcomply.app
# Local/preview may remain false. The protected Production deploy forces this true and fails closed unless Resend + EMAIL_FROM are bound.
REQUIRE_TRANSACTIONAL_EMAIL_DELIVERY=false

# Security / healthchecks / distributed rate limiting
HEALTHCHECK_TOKEN=
AUDIT_CHAIN_SIGNING_SECRET=
EVIDENCE_PACK_SIGNING_SECRET=
STEP_UP_SIGNING_SECRET=
CRON_SECRET=
INTERNAL_CRON_SECRET=
DAILY_MAINTENANCE_JOB_TIMEOUT_MS=25000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Enterprise step-up / MFA provider policy
# Production application runtime must explicitly select its step-up provider mode.
STEP_UP_PROVIDER_MODE=supabase_mfa_or_enterprise_idp
STEP_UP_IDP_ACR_VALUES=
STEP_UP_IDP_AMR_VALUES=
# The protected Step-Up Runtime Proof creates, enrolls and deletes its own synthetic MFA user/factor.
# No persistent email/password/TOTP fixture secret is required.

# One-off local/protected-shell ops values; never expose in browser or commit real values.
# Used by scripts/ops/provision-platform-admin.mjs to create the first platform admin row.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_ROLE=owner

# Upload malware/content scanning
REQUIRE_MALWARE_SCAN_FOR_UPLOADS=true
MALWARE_SCANNER_PROVIDER=http
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_URL=
MALWARE_SCANNER_API_KEY=
MALWARE_SCANNER_ALLOWED_HOSTS=
MALWARE_SCANNER_CLAMAV_HOST=
MALWARE_SCANNER_CLAMAV_PORT=3310
MALWARE_SCANNER_TIMEOUT_MS=10000

# Observability / Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Product analytics / PostHog EU
# Use the Project API Key from the approved PostHog EU project. It is a public browser key, but never commit a real value here.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_ASSET_HOST=https://eu-assets.i.posthog.com
# Production is fail-closed: the protected deployment forces this to true.
NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=true

# CI/CD provider-only values
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Vercel Project Settings production mapping
# Public/non-sensitive values: NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_SITE_URL, TRUSTED_ORIGINS,
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY,
# STRIPE_PRICE_ESSENTIAL_MONTHLY, STRIPE_PRICE_ESSENTIAL_ANNUAL,
# STRIPE_PRICE_PROFESSIONAL_MONTHLY, STRIPE_PRICE_PROFESSIONAL_ANNUAL,
# STRIPE_PRICE_BUSINESS_MONTHLY, STRIPE_PRICE_BUSINESS_ANNUAL,
# RISCK_COMPLY_PAID_BILLING_REQUIRED, GOOGLE_CLIENT_ID, EMAIL_FROM, REQUIRE_TRANSACTIONAL_EMAIL_DELIVERY,
# ENABLE_DASHBOARD_METRIC_SNAPSHOTS, REQUIRE_MALWARE_SCAN_FOR_UPLOADS, MALWARE_SCANNER_PROVIDER,
# MALWARE_SCANNER_ALLOWED_HOSTS, MALWARE_SCANNER_CLAMAV_PORT, MALWARE_SCANNER_TIMEOUT_MS,
# NEXT_PUBLIC_SENTRY_DSN, SENTRY_ORG, SENTRY_PROJECT,
# NEXT_PUBLIC_POSTHOG_KEY, NEXT_PUBLIC_POSTHOG_HOST, NEXT_PUBLIC_POSTHOG_ASSET_HOST,
# NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT, RELEASE_TARGET.
# Sensitive values must be configured only in Vercel/GitHub protected provider stores.

# Production checklist
# 1. Run only reviewed/approved Supabase migrations through the controlled migration workflow; do not apply repository migrations ad hoc.
# 2. Configure Supabase Auth Site URL and exact Redirect URLs for local, preview and production.
# 3. Enable only the Supabase Auth providers used by production login/signup.
# 4. Create Stripe live canonical Prices for Essential (€49), Professional (€149) and Business (€399) when authorized; Enterprise remains customer-contract priced.
# 5. Configure the canonical Stripe Price environment keys and verify them with Stripe Commercial Catalog Proof before calling the new commercial catalog live.
# 6. Configure Stripe webhook endpoint: /api/stripe/webhook with checkout/subscription/invoice events.
# 7. Configure an active live Stripe Billing Portal configuration and keep config/stripe-billing-portal-contract.json aligned: null requires a usable active live account default; a reviewed bpc_... value pins that exact configuration.
# 8. Set RISCK_COMPLY_PAID_BILLING_REQUIRED=true before selling paid plans.
# 9. Configure RESEND_API_KEY and the verified EMAIL_FROM sender in the protected Production environment; the deploy forces REQUIRE_TRANSACTIONAL_EMAIL_DELIVERY=true.
# 10. Keep ENABLE_DASHBOARD_METRIC_SNAPSHOTS=false in Production until V19 is applied; /api/ready fails closed on incompatible snapshot schema if the feature is later enabled.
# 11. Set SENTRY_AUTH_TOKEN if source maps/releases should be uploaded during CI/Vercel builds.
# 12. Configure CRON_SECRET for Vercel cron and internal scheduled jobs.
# 13. Configure UPSTASH_REDIS_* before heavy public traffic.
# 14. Set AUDIT_CHAIN_SIGNING_SECRET before enabling audit-chain verification evidence.
# 15. Set EVIDENCE_PACK_SIGNING_SECRET before sharing Audit Evidence Packs externally.
# 16. Configure STEP_UP_PROVIDER_MODE and a dedicated step-up signing secret before enterprise production; the protected proof creates its own disposable MFA fixture.
# 17. Set REQUIRE_MALWARE_SCAN_FOR_UPLOADS=true and configure a real MALWARE_SCANNER_PROVIDER plus its complete transport before enabling enterprise uploads.
# 18. Configure the approved PostHog EU Project API Key as protected Production variable NEXT_PUBLIC_POSTHOG_KEY; the protected deploy synchronizes that key plus the EU hosts and consent-required policy to Vercel before the Production build.
# 19. After deploy, verify the browser bundle is bound to the same approved PostHog project without printing the key, then prove a consented event reaches that project.
# 20. Keep screenshots/exports containing values outside the repository.
# 21. Provision at least one platform admin after the first successful login before using the internal Sales Console.
