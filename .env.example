# EuroComply environment variables
# Copy production values into provider secret stores only (Vercel Project Settings, GitHub Environments/Secrets, Supabase, Stripe, Sentry).
# Do not commit real values in this file.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

# Email
RESEND_API_KEY=
EMAIL_FROM="EuroComply <no-reply@eurocomply.app>"
SUPPORT_EMAIL=support@eurocomply.app

# Security / healthchecks / distributed rate limiting
# HEALTHCHECK_TOKEN protects /api/ready in production.
HEALTHCHECK_TOKEN=
# Required to sign/verify audit-chain events and security evidence.
AUDIT_CHAIN_SIGNING_SECRET=
# Optional. Used to sign exported Audit Evidence Packs. Falls back to HEALTHCHECK_TOKEN when empty.
EVIDENCE_PACK_SIGNING_SECRET=
# Required for protected step-up authentication challenges.
STEP_UP_SIGNING_SECRET=
# Required for protected Vercel/internal cron routes.
CRON_SECRET=
# Optional fallback for internal cron routes when CRON_SECRET is not used.
INTERNAL_CRON_SECRET=
# Optional per-job timeout for the daily maintenance aggregator in milliseconds.
DAILY_MAINTENANCE_JOB_TIMEOUT_MS=25000
# Optional. When empty, EuroComply falls back to local in-memory rate limiting for dev/test.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Observability / Sentry
# Public DSN used by browser and edge runtime.
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only DSN. Falls back to NEXT_PUBLIC_SENTRY_DSN when empty.
SENTRY_DSN=
# Required only when uploading source maps during CI/Vercel builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# CI/CD provider-only values
# Configure these as GitHub Actions secrets; they are listed here for required-name inventory only.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Production checklist
# 1. Run every SQL file in supabase/migrations in Supabase, in filename order.
# 2. Create Stripe live products/prices for Essential, Professional and Business.
# 3. Configure Stripe webhook endpoint: /api/billing/webhook.
# 4. Set SENTRY_AUTH_TOKEN if source maps/releases should be uploaded during Vercel builds.
# 5. Configure CRON_SECRET for Vercel cron and internal scheduled jobs.
# 6. Configure UPSTASH_REDIS_* before heavy public traffic.
# 7. Set AUDIT_CHAIN_SIGNING_SECRET before enabling audit-chain verification evidence.
# 8. Set EVIDENCE_PACK_SIGNING_SECRET before sharing Audit Evidence Packs externally.
# 9. Keep screenshots/exports containing values outside the repository.
