# RISCK COMPLY environment variables
# Copy production values into provider secret stores only (Vercel Project Settings, GitHub Environments/Secrets, Supabase, Stripe, Sentry).
# Do not commit real values in this file.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# Supabase Auth / OAuth redirect allowlist
# Add exact callback URLs in Supabase Authentication > URL Configuration > Redirect URLs.
# Local: http://localhost:3000/auth/callback
# Production: https://<production-host>/auth/callback
# Preview: https://<preview-host>/auth/callback or the strict preview pattern approved for the deployment provider.
SUPABASE_AUTH_SITE_URL=http://localhost:3000
SUPABASE_AUTH_REDIRECT_URLS=http://localhost:3000/auth/callback,https://<production-host>/auth/callback,https://<preview-host>/auth/callback

# Google OAuth for Supabase Auth
# Store these values only in server-side/provider secret stores and Supabase Auth provider settings.
# Never prefix GOOGLE_CLIENT_SECRET with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

# Email
RESEND_API_KEY=
EMAIL_FROM="RISCK COMPLY <no-reply@risckcomply.app>"
SUPPORT_EMAIL=support@risckcomply.app

# Security / healthchecks / distributed rate limiting
# Required. HEALTHCHECK_TOKEN protects /api/ready in every environment.
HEALTHCHECK_TOKEN=
# Required to sign/verify audit-chain events and security evidence.
AUDIT_CHAIN_SIGNING_SECRET=
# Optional. Used to sign exported Audit Evidence Packs. Falls back to HEALTHCHECK_TOKEN when empty.
EVIDENCE_PACK_SIGNING_SECRET=
# Required for protected step-up authentication challenges.
STEP_UP_SIGNING_SECRET=
# Required for production/enterprise distributed rate limiting readiness.
# Supported values: supabase_mfa, enterprise_idp, hybrid.
STEP_UP_PROVIDER_MODE=
# Required only for STEP_UP_PROVIDER_MODE=enterprise_idp or hybrid when relying on IdP reauthentication.
STEP_UP_IDP_ACR_VALUES=
STEP_UP_IDP_AMR_VALUES=
# Set to true only after running a live Supabase MFA/enterprise IdP runtime validation in the target environment.
STEP_UP_RUNTIME_PROVIDER_PROOF=false
# Optional. Defaults are intentionally short-lived.
STEP_UP_MAX_AGE_MS=300000
STEP_UP_CHALLENGE_MAX_AGE_MS=120000
# Required for protected Vercel/internal cron routes.
CRON_SECRET=
# Optional fallback for internal cron routes when CRON_SECRET is not used.
INTERNAL_CRON_SECRET=
# Optional per-job timeout for the daily maintenance aggregator in milliseconds.
DAILY_MAINTENANCE_JOB_TIMEOUT_MS=25000
# Required for production/enterprise distributed rate limiting readiness.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upload malware/content scanning
# Enterprise deployments must set REQUIRE_MALWARE_SCAN_FOR_UPLOADS=true and configure a real scanner provider.
REQUIRE_MALWARE_SCAN_FOR_UPLOADS=true
# Supported providers: clamav, clamd, http, generic-http, webhook.
MALWARE_SCANNER_PROVIDER=http
# HTTP/webhook providers use MALWARE_SCANNER_ENDPOINT or MALWARE_SCANNER_URL plus optional MALWARE_SCANNER_API_KEY.
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_URL=
MALWARE_SCANNER_API_KEY=
# ClamAV/clamd providers use host/port. Timeout applies to all providers.
MALWARE_SCANNER_CLAMAV_HOST=
MALWARE_SCANNER_CLAMAV_PORT=3310
MALWARE_SCANNER_TIMEOUT_MS=10000

# Observability / Sentry
# Public DSN used by browser and edge runtime.
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only DSN. Falls back to NEXT_PUBLIC_SENTRY_DSN when empty.
SENTRY_DSN=
# Required only when uploading source maps during CI/Vercel builds.
# Source maps are not uploaded unless SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT are all configured.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# CI/CD provider-only values
# Configure these as GitHub Actions secrets; they are listed here for required-name inventory only.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Production checklist
# 1. Run every SQL file in supabase/migrations in Supabase, in filename order.
# 2. Create Stripe live products/prices for Essential, Professional and Business.
# 3. Configure Stripe webhook endpoint: /api/billing/webhook.
# 4. Set SENTRY_AUTH_TOKEN if source maps/releases should be uploaded during CI/Vercel builds.
# 5. Configure CRON_SECRET for Vercel cron and internal scheduled jobs.
# 6. Configure UPSTASH_REDIS_* before heavy public traffic.
# 7. Set AUDIT_CHAIN_SIGNING_SECRET before enabling audit-chain verification evidence.
# 8. Set EVIDENCE_PACK_SIGNING_SECRET before sharing Audit Evidence Packs externally.
# 9. Set REQUIRE_MALWARE_SCAN_FOR_UPLOADS=true and configure a real MALWARE_SCANNER_PROVIDER before enabling enterprise uploads.
# 10. Configure Google OAuth only in Google Cloud Console and Supabase Auth provider settings; keep GOOGLE_CLIENT_SECRET server-only.
# 11. Run live Google OAuth and step-up MFA/IdP validations before marking enterprise release Go.
# 12. Keep screenshots/exports containing values outside the repository.
