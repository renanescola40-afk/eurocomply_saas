# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=

# Observability / Sentry
# Public DSN used by browser and edge runtime.
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only DSN. Falls back to NEXT_PUBLIC_SENTRY_DSN when empty.
SENTRY_DSN=
# Required only when uploading source maps during CI/Vercel builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
