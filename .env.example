# RISCK COMPLY environment variables
# Copy production values into provider secret stores only (Vercel Project Settings, GitHub Environments/Secrets, Supabase, Stripe, Sentry, PostHog).
# Do not commit real values in this file.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
NODE_ENV=development
RELEASE_TARGET=production
RISCK_COMPLY_PAID_BILLING_REQUIRED=false

# Supabase Auth and database
# Supabase Auth is the single primary identity provider for the active application.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# Supabase Auth / OAuth redirect allowlist
# Add exact callback URLs in Supabase Authentication > URL Configuration > Redirect URLs.
# Local: http://localhost:3000/auth/callback
# Production: https://<production-host>/auth/callback
# Preview: https://<preview-host>/auth/callback or the strict preview pattern approved for the deployment provider.
SUPABASE_AUTH_SITE_URL=http://localhost:3000
SUPABASE_AUTH_REDIRECT_URLS=http://localhost:3000/auth/callback,https://<production-host>/auth/callback,https://<preview-host>/auth/callback

# Google OAuth for Supabase Auth
# Store these values only in server-side/provider secret stores and Supabase Auth provider settings.
# Never prefix GOOGLE_CLIENT_SECRET with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
# Legacy fallbacks accepted temporarily by runtime/preflight. Prefer the canonical envs above.
STRIPE_PRICE_ESSENTIAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ENTERPRISE_MONTHLY=

# Email
RESEND_API_KEY=
EMAIL_FROM="RISCK COMPLY <no-reply@risckcomply.app>"
SUPPORT_EMAIL=support@risckcomply.app

# Security / healthchecks / distributed rate limiting
HEALTHCHECK_TOKEN=
AUDIT_CHAIN_SIGNING_SECRET=
EVIDENCE_PACK_SIGNING_SECRET=
STEP_UP_SIGNING_SECRET=
CRON_SECRET=
INTERNAL_CRON_SECRET=
DAILY_MAINTENANCE_JOB_TIMEOUT_MS=25000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Enterprise step-up / MFA provider policy
STEP_UP_PROVIDER_MODE=supabase_mfa_or_enterprise_idp
STEP_UP_IDP_ACR_VALUES=
STEP_UP_IDP_AMR_VALUES=
STEP_UP_RUNTIME_PROVIDER_PROOF=false

# One-off local/protected-shell ops values; never expose in browser or commit real values.
# Used by scripts/ops/provision-platform-admin.mjs to create the first platform admin row.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_ROLE=owner

# Upload malware/content scanning
REQUIRE_MALWARE_SCAN_FOR_UPLOADS=true
MALWARE_SCANNER_PROVIDER=http
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_URL=
MALWARE_SCANNER_API_KEY=
MALWARE_SCANNER_ALLOWED_HOSTS=
MALWARE_SCANNER_CLAMAV_HOST=
MALWARE_SCANNER_CLAMAV_PORT=3310
MALWARE_SCANNER_TIMEOUT_MS=10000

# Observability / Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Product analytics / PostHog EU
# Use the Project API Key from the PostHog EU project. Do not commit a real key here.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_ASSET_HOST=https://eu-assets.i.posthog.com

# CI/CD provider-only values
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Vercel Project Settings production mapping
# Public/non-sensitive values: NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_SITE_URL, TRUSTED_ORIGINS,
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY,
# STRIPE_PRICE_STARTER_MONTHLY, STRIPE_PRICE_GROWTH_MONTHLY, STRIPE_PRICE_ENTERPRISE_MONTHLY,
# RISCK_COMPLY_PAID_BILLING_REQUIRED, GOOGLE_CLIENT_ID, REQUIRE_MALWARE_SCAN_FOR_UPLOADS,
# MALWARE_SCANNER_PROVIDER, MALWARE_SCANNER_ALLOWED_HOSTS, MALWARE_SCANNER_CLAMAV_PORT,
# MALWARE_SCANNER_TIMEOUT_MS, NEXT_PUBLIC_SENTRY_DSN, SENTRY_ORG, SENTRY_PROJECT, RELEASE_TARGET.
# Sensitive values must be configured only in Vercel/GitHub protected provider stores.

# Production checklist
# 1. Run every SQL file in supabase/migrations in Supabase, in filename order.
# 2. Configure Supabase Auth Site URL and exact Redirect URLs for local, preview and production.
# 3. Enable only the Supabase Auth providers used by production login/signup.
# 4. Create Stripe live products/prices for Starter, Growth and Enterprise.
# 5. Configure Stripe webhook endpoint: /api/stripe/webhook with checkout/subscription/invoice events.
# 6. Set RISCK_COMPLY_PAID_BILLING_REQUIRED=true before selling paid plans.
# 7. Set SENTRY_AUTH_TOKEN if source maps/releases should be uploaded during CI/Vercel builds.
# 8. Configure CRON_SECRET for Vercel cron and internal scheduled jobs.
# 9. Configure UPSTASH_REDIS_* before heavy public traffic.
# 10. Set AUDIT_CHAIN_SIGNING_SECRET before enabling audit-chain verification evidence.
# 11. Set EVIDENCE_PACK_SIGNING_SECRET before sharing Audit Evidence Packs externally.
# 12. Configure STEP_UP_* values and Supabase MFA/enterprise IdP policy before enterprise production.
# 13. Set REQUIRE_MALWARE_SCAN_FOR_UPLOADS=true and configure a real MALWARE_SCANNER_PROVIDER before enabling enterprise uploads.
# 14. Configure NEXT_PUBLIC_POSTHOG_KEY in Vercel from the PostHog EU project before enabling product analytics.
# 15. Keep screenshots/exports containing values outside the repository.
# 16. Provision at least one platform admin after the first successful login before using the internal Sales Console.
