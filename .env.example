# EuroComply environment variables
# Copy the production values into Vercel Project Settings > Environment Variables.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM="EuroComply <no-reply@eurocomply.app>"
SUPPORT_EMAIL=support@eurocomply.app

# Security / distributed rate limiting
# Optional. When empty, EuroComply falls back to local in-memory rate limiting for dev/test.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Observability / Sentry
# Public DSN used by browser and edge runtime.
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only DSN. Falls back to NEXT_PUBLIC_SENTRY_DSN when empty.
SENTRY_DSN=
# Required only when uploading source maps during CI/Vercel builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Production checklist
# 1. Run supabase/migrations/20260610_public_launch_readiness.sql in Supabase.
# 2. Create Stripe live products/prices and configure the webhook endpoint.
# 3. Set SENTRY_AUTH_TOKEN if source maps/releases should be uploaded during Vercel builds.
# 4. Configure UPSTASH_REDIS_* before heavy public traffic.
