{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/internal/metric-snapshots",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/compliance-alerts",
