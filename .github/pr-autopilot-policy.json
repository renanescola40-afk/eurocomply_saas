{
  "version": 1,
  "trustedAuthors": [
    "renanescola40-afk",
    "github-actions[bot]"
  ],
  "trustedBranchPrefixes": [
    "agent/",
    "fix/",
    "codex/",
    "chore/",
    "docs/",
    "test/"
  ],
  "limits": {
    "maxChangedFiles": 80,
    "maxAdditions": 1200,
    "maxAutofixAttempts": 2
  },
  "labels": {
    "mergeOptIn": "autopilot:merge",
    "eligible": "autopilot:eligible",
    "blocked": "autopilot:blocked",
    "autofixAllowed": "autofix:allowed",
    "highRisk": "risk:high"
  },
  "blockedPathPrefixes": [
    ".github/workflows/",
    ".github/actions/",
    "supabase/",
    "migrations/",
    "scripts/security/",
    "scripts/release/",
    "src/app/api/",
    "src/app/next_api/",
    "src/middleware",
    "src/lib/auth",
    "src/lib/billing",
    "src/lib/stripe",
    "src/lib/supabase",
    "src/server/auth",
    "src/server/audit",
    "src/server/billing",
    "src/server/rbac",
    "src/server/security",
    "src/server/stripe",
    "src/server/supabase",
    "src/server/tenancy",
    "docs/legal/",
    "docs/security/evidence/runtime/",
    "package.json",
    "package-lock.json",
    "AGENTS.md",
    ".github/senior-agent.yml",
    ".github/pr-autopilot-policy.json"
  ],
  "blockedPathRegexes": [
    "(^|/)(auth|authorization|rbac|rls|tenant|tenancy|billing|stripe|webhook|secret|security|audit|migration|middleware)(/|\\.|-)",
    "\\.sql$",
    "(^|/)Dockerfile$",
    "(^|/)(vercel|sentry|supabase)\\.json$"
  ],
  "automaticMergeSafePathPrefixes": [
    "docs/operations/",
    "docs/decisions/",
    ".github/ISSUE_TEMPLATE/"
  ],
  "automaticMergeSafeExactPaths": [
    "README.md",
    ".github/pull_request_template.md"
  ],
  "automaticMergeSafePathRegexes": [
    "^tests/(?!security/).+\\.(test|spec)\\.[cm]?[jt]sx?$",
    "^src/.+\\.(test|spec)\\.[cm]?[jt]sx?$"
  ],
  "autofixAllowedPathPrefixes": [
    "src/app/",
    "src/components/",
    "src/lib/",
    "tests/",
    "docs/",
    "public/"
  ],
  "autofixAllowedExactPaths": [
    "README.md"
  ],
  "autofixAllowedPathRegexes": [],
  "mergeRequirements": {
    "requireApprovedReview": true,
    "requireAllThreadsResolved": true,
    "requireStatusRollupSuccess": true,
    "mergeMethod": "SQUASH"
  }
}
